{
  "expo": {
    "name": "Tab Rat",
    "slug": "tab-rat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tabrat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lauramooo.tabrat",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lauramooo.tabrat",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFBEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tab Rat needs photo access to read your receipt.",
          "cameraPermission": "Tab Rat needs camera access to photograph your receipt.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Tab Rat to use Face ID to protect your API key."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-web-browser",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5cf6ee0b-8c3d-4197-abbc-bce73449ad18"
      }
    },
    "owner": "lauramooo"
  }
}
